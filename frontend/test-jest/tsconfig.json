// Usado apenas para checagem de tipos (vue-tsc). A execução usa SWC (ver support/).
{
  "extends": "../tsconfig.app.json",
  "include": ["../env.d.ts", "../src/**/*", "../src/**/*.vue", "./**/*.ts"],
  "exclude": ["../src/**/__tests__/*"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "types": ["jest", "node"],
    "noEmit": true,
    "paths": { "@/*": ["../src/*"] },
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.jest.tsbuildinfo"
  }
}
